2.organization(Intermediary), tp2.transaction(t2)).select(","-    aggs.count(t2).alias(\"harbor_deals_total\")).to_df().to_string(index=False))","+# Any company party (not just target) on Harbor Lane deals","+parties = model.where(","+    adv.organization(Intermediary),","+    Intermediary.name == \"Harbor Lane Advisors\",","+    adv.transaction(Transaction),","+    party.transaction(Transaction),","+    party.organization(c),","+).select(","+    Transaction.id.alias(\"deal_id\"),","+    c.id.alias(\"company_id\"),","+    c.name.alias(\"company\"),","+    party.party_role.alias(\"party_role\"),","+).to_df()","+","+print(f\"Harbor Lane deals: {len(deals)}; Tier A companies: {len(tier_a)}\")","+print(\"\\nTarget is Tier A:\")","+print(deals.merge(tier_a, left_on=\"target_id\", right_on=\"company_id\").sort_values(\"score\", ascending=False).to_string(index=False))","+print(\"\\nTier A company as any party:\")","+print(parties.merge(tier_a, on=[\"company_id\", \"company\"]).to_string(index=False))"]}],"originalFile":"import os, sys; os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\")); sys.path.insert(0, \".\")\nimport pe_deal_graph.queries  # noqa: F401  (loads core, rules and graphs)\nfrom pe_deal_graph.model.core import (model, Company, EligibleTarget, Intermediary, Transaction,\n                                      TransactionParty, DealFlowTransaction)\nfrom relationalai.semantics.std import aggregates as aggs\n\nimport pandas as pd\npd.set_option(\"display.width\", 250); pd.set_option(\"display.max_columns\", 20)\n\nHARBOR = \"Harbor Lane Advisors\"\n\n# Harbor Lane deals (any party role) whose target is a Tier A eligible target\ntp, t = TransactionParty.ref(), Transaction.ref()\nhits = model.where(\n    Intermediary.name == HARBOR, tp.organization(Intermediary), tp.transaction(t), t.target(Company),\n    EligibleTarget(Company), Company.tier == \"A\",\n).select(\n    Company.name.alias(\"target\"),\n    Company.score.alias(\"score\"),\n    Company.fit_points.alias(\"fit\"),\n    Company.readiness_points.alias(\"readiness\"),\n    t.id.alias(\"deal_id\"),\n    t.close_date.alias(\"close_date\"),\n    t.deal_role.alias(\"deal_role\"),\n    t.structure.alias(\"structure\"),\n    tp.party_role.alias(\"harbor_role\"),\n).to_df()\nin_flow = model.where(Intermediary.name == HARBOR, tp.organization(Intermediary), tp.transaction(t),\n                      DealFlowTransaction(t), t.target(Company), EligibleTarget(Company), Company.tier == \"A\",\n                      ).select(t.id.alias(\"deal_id\")).to_df()\nhits[\"in_5y_thesis_flow\"] = hits[\"deal_id\"].isin(in_flow[\"deal_id\"])\nprint(hits.sort_values([\"score\", \"close_date\"], ascending=[False, False]).to_string(index=False))\n\ntp2, t2 = TransactionParty.ref(), Transaction.ref()\nprint(model.where(Intermediary.name == HARBOR, tp2.organization(Intermediary), tp2.transaction(t2)).select(\n    aggs.count(t2).alias(\"harbor_deals_total\")).to_df().to_string(index=False))\n","userModified":false},"tool_result_meta":[{"id":"toolu_01KVm5EDj72GVGwAFzEiQvQW","permission_decision":{"decision":"accept","source":"user_permanent","reason_type":"rule"}}]}
