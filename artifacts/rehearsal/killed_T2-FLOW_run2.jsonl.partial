{"type":"assistant","message":{"model":"claude-opus-5-5","id":"msg_011CgHAE5j5NEkxksg5UPoPZ","type":"message","role":"assistant","content":[{"type":"tool_use","id":"toolu_01KVm5EDj72GVGwAFzEiQvQW","name":"Write","input":{"file_path":"/Users/piotrkraus/rai-repos/pe_deal_graph_demo/demo_workspace/scratch/harbor_lane_tier_a.py","content":"import os, sys; os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\")); sys.path.insert(0, \".\")\nimport pandas as pd\nimport pe_deal_graph.queries\nfrom pe_deal_graph.model.core import model, Company, EligibleTarget, Intermediary, Transaction, TransactionParty, DealFlowTransaction\n\npd.set_option(\"display.width\", 250)\n\nadv = TransactionParty.ref()\nparty = TransactionParty.ref()\nc = Company.ref()\n\n# Every Harbor Lane deal and the target company\ndeals = model.where(\n    adv.organization(Intermediary),\n    Intermediary.name == \"Harbor Lane Advisors\",\n    adv.transaction(Transaction),\n    Transaction.target(Company),\n).select(\n    Transaction.id.alias(\"deal_id\"),\n    Transaction.close_date.alias(\"close_date\"),\n    adv.party_role.alias(\"harbor_role\"),\n    Company.id.alias(\"target_id\"),\n    Company.name.alias(\"target\"),\n    Transaction.deal_role.alias(\"deal_role\"),\n    Transaction.seller_type.alias(\"seller_type\"),\n).to_df()\n\n# Tier A companies: EligibleTarget with score >= 70\ntier_a = model.where(EligibleTarget(Company), Company.score >= 70).select(\n    Company.id.alias(\"company_id\"),\n    Company.name.alias(\"company\"),\n    Company.score.alias(\"score\"),\n    Company.fit_points.alias(\"fit_points\"),\n    Company.readiness_points.alias(\"readiness_points\"),\n).to_df()\n\n# Any company party (not just target) on Harbor Lane deals\nparties = model.where(\n    adv.organization(Intermediary),\n    Intermediary.name == \"Harbor Lane Advisors\",\n    adv.transaction(Transaction),\n    party.transaction(Transaction),\n    party.organization(c),\n).select(\n    Transaction.id.alias(\"deal_id\"),\n    c.id.alias(\"company_id\"),\n    c.name.alias(\"company\"),\n    party.party_role.alias(\"party_role\"),\n).to_df()\n\nprint(f\"Harbor Lane deals: {len(deals)}; Tier A companies: {len(tier_a)}\")\nprint(\"\\nTarget is Tier A:\")\nprint(deals.merge(tier_a, left_on=\"target_id\", right_on=\"company_id\").sort_values(\"score\", ascending=False).to_string(index=False))\nprint(\"\\nTier A company as any party:\")\nprint(parties.merge(tier_a, on=[\"company_id\", \"company\"]).to_string(index=False))\n"},"caller":{"type":"direct"}}],"container":null,"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":862,"cache_read_input_tokens":37068,"cache_creation":{"ephemeral_5m_input_tokens":862,"ephemeral_1h_input_tokens":0},"output_tokens":8,"service_tier":"standard","inference_geo":"global","speed":"standard"},"input_transformations":[],"diagnostics":null,"context_management":null},"parent_tool_use_id":null,"session_id":"78743bdf-4093-4fd6-a83c-29597099f650","uuid":"5efdec64-c56a-485d-a92b-97601c38a378","timestamp":"2026-10-22T11:00:33.455Z","request_id":"req_011CgHAE4xSXVrJAMzCGvfLN","wire_tool_inputs":{"toolu_01KVm5EDj72GVGwAFzEiQvQW":{"file_path":"/Users/piotrkraus/rai-repos/pe_deal_graph_demo/demo_workspace/scratch/harbor_lane_tier_a.py","content":"import os, sys; os.chdir(os.path.join(os.path.dirname(os.path.abspath(__file__)), \"..\", \"..\")); sys.path.insert(0, \".\")\nimport pandas as pd\nimport pe_deal_graph.queries\nfrom pe_deal_graph.model.core import model, Company, EligibleTarget, Intermediary, Transaction, TransactionParty, DealFlowTransaction\n\npd.set_option(\"display.width\", 250)\n\nadv = TransactionParty.ref()\nparty = TransactionParty.ref()\nc = Company.ref()\n\n# Every Harbor Lane deal and the target company\ndeals = model.where(\n    adv.organization(Intermediary),\n    Intermediary.name == \"Harbor Lane Advisors\",\n    adv.transaction(Transaction),\n    Transaction.target(Company),\n).select(\n    Transaction.id.alias(\"deal_id\"),\n    Transaction.close_date.alias(\"close_date\"),\n    adv.party_role.alias(\"harbor_role\"),\n    Company.id.alias(\"target_id\"),\n    Company.name.alias(\"target\"),\n    Transaction.deal_role.alias(\"deal_role\"),\n    Transaction.seller_type.alias(\"seller_type\"),\n).to_df()\n\n# Tier A companies: EligibleTarget with score >= 70\ntier_a = model.where(EligibleTarget(Company), Company.score >= 70).select(\n    Company.id.alias(\"company_id\"),\n    Company.name.alias(\"company\"),\n    Company.score.alias(\"score\"),\n    Company.fit_points.alias(\"fit_points\"),\n    Company.readiness_points.alias(\"readiness_points\"),\n).to_df()\n\n# Any company party (not just target) on Harbor Lane deals\nparties = model.where(\n    adv.organization(Intermediary),\n    Intermediary.name == \"Harbor Lane Advisors\",\n    adv.transaction(Transaction),\n    party.transaction(Transaction),\n    party.organization(c),\n).select(\n    Transaction.id.alias(\"deal_id\"),\n    c.id.alias(\"company_id\"),\n    c.name.alias(\"company\"),\n    party.party_role.alias(\"party_role\"),\n).to_df()\n\nprint(f\"Harbor Lane deals: {len(deals)}; Tier A companies: {len(tier_a)}\")\nprint(\"\\nTarget is Tier A:\")\nprint(deals.merge(tier_a, left_on=\"target_id\", right_on=\"company_id\").sort_values(\"score\", ascending=False).to_string(index=False))\nprint(\"\\nTier A company as any party:\")\nprint(parties.merge(tier_a, on=[\"company_id\", \"company\"]).to_string(index=False))\n"}}}
